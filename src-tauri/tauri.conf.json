{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VizorPlay",
  "version": "1.0.0",
  "identifier": "com.b4l1.clipmaker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VizorPlay",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/backend/": "backend/"
    },
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      }
    },
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNzY4MEVCOTY1RDBBRDgKUldUWUNsMlc2NEIydXpjNWtUdFhhMEgvSmgrMTFhSGxKZTkyamhYSlkrQjQwWGpaQUZrMHVsdXQK",
      "endpoints": [
        "https://github.com/B03GHB4L1/ClipMaker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
